PORT=3000
NODE_ENV=development

# Conexión a Base de Datos PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://biblioteca_user:biblioteca_password@localhost:5432/biblioteca_db?schema=public"

# Seguridad y Autenticación JWT
JWT_SECRET="clave_secreta_jwt_unamad_biblioteca_central_2026_segura"
JWT_EXPIRES_IN="7d"

# Reglas de Negocio Institucionales
TARIFA_MORA_POR_DIA=1.50
STORAGE_DIR="./storage/libros"
CORS_ORIGIN="*"
